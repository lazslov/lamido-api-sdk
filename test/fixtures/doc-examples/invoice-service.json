            {
              "key": "bankAccountId",
              "label": "Bankszámla id",
              "type": "number",
              "required": true,
              "help": "Numeric id of the bank account shown on the invoice."
            }
          ],
          "envFallback": [
            "<CONFIGID>_API_KEY",
            "<CONFIGID>_BLOCK_ID",
            "<CONFIGID>_BANK_ACCOUNT_ID"
          ],
          "testDescription": "Calls GET /partners to verify the API key, then checks that the configured blockId and bankAccountId actually exist on the account. Issues nothing."
        }
      ]
    }
