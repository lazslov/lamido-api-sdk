    "context": "`GET /v1/admin/providers`",
    "json": {
      "data": [
        {
          "name": "szamlazz",
          "label": "szamlazz.hu (Számla Agent)",
          "config_id_prefix": "szamlazz_",
          "secret": {
            "label": "Agent kulcs",
            "help": "Számla Agent key from szamlazz.hu → Beállítások → Számla Agent."
          },
          "config_fields": [],
          "env_fallback": [
            "<CONFIGID>_AGENT_KEY"
          ],
          "test_description": "Queries a deliberately nonexistent invoice and inspects the szlahu_error_code header. An auth-class code means the key is wrong; anything else (including not-found) means it authenticated. Issues nothing. Heuristic — szamlazz has no read-only ping endpoint."
        },
        {
          "name": "billingo",
          "label": "Billingo (v3)",
          "config_id_prefix": "billingo_",
          "secret": {
            "label": "API key",
            "help": "Billingo API key from Beállítások → API kulcsok."
          },
          "config_fields": [
            {
              "key": "blockId",
              "label": "Számlatömb (block) id",
              "type": "number",
              "required": true,
              "help": "Numeric id of the invoice block the documents are issued into."
            },
            {
              "key": "bankAccountId",
              "label": "Bankszámla id",
              "type": "number",
              "required": true,
              "help": "Numeric id of the bank account shown on the invoice."
            }
          ],
          "env_fallback": [
            "<CONFIGID>_API_KEY",
            "<CONFIGID>_BLOCK_ID",
            "<CONFIGID>_BANK_ACCOUNT_ID"
          ],
          "test_description": "Calls GET /partners to verify the API key, then checks that the configured blockId and bankAccountId actually exist on the account. Issues nothing."
        }
      ],
      "next_cursor": null
    }
  },
