# .env.live.example — copy to `.env.live` and fill in.
#
#   cp .env.live.example .env.live
#
# `.env.live` is untracked and must stay that way: `.gitignore` ignores `.env.*`, and this
# example is the single exception it re-includes. **Never paste a filled-in value into a chat,
# a commit message, an issue or a pull request.** If one leaks, rotate it rather than deleting
# the message — the copy in someone's notification e-mail does not go away.
#
# Two audiences, one file:
#
#   • `pnpm test:live` reads everything below except NPM_TOKEN.
#   • The release workflow needs the same values as GitHub **environment** secrets on the
#     `release` environment, plus NPM_TOKEN. See "Getting these into GitHub" at the bottom.
#
# Point every URL at a SCRATCH tenant. payment-service's preview and production share a
# database, so "preview" is not a synonym for "safe" — see docs/live-testing.md §2.

# ─── content-service ────────────────────────────────────────────────────────────────────
# Base URL with no trailing slash. There is no fallback host: the SDK reports a missing base
# URL as a configuration error rather than guessing one.
CONTENT_SERVICE_BASE_URL=http://localhost:3000

# The client tier. Server-only — it can write drafts and publish. Mint it with the admin API
# or the seed script; `POST /v1/admin/sites/{id}/keys` returns the plaintext exactly once.
CONTENT_SERVICE_SECRET_KEY=csk_REPLACE_ME

# The website tier, browser-safe. Optional: enables one more case, which proves a `cpk_` key
# is refused on the client tier rather than quietly working.
CONTENT_SERVICE_PUBLISHABLE_KEY=cpk_REPLACE_ME

# A page slug the suite may write to and publish. Optional: enables the round-trip case, which
# is the only one that proves a patch survives a publish. Leave empty to skip it.
# Requires LIVE_ALLOW_WRITES=true as well.
CONTENT_SERVICE_SCRATCH_SLUG=

# ─── invoice-service ────────────────────────────────────────────────────────────────────
INVOICE_SERVICE_BASE_URL=http://localhost:3001

# The client tier. There is no browser-safe tier on this service at all: an `isk_` key can read
# every invoice of its tenant and issue real stornos.
INVOICE_SERVICE_CLIENT_KEY=isk_REPLACE_ME

# Which stored provider credential issues. Must match `^[a-z0-9_]+$`, be at most 64 characters,
# start with `szamlazz_` or `billingo_`, AND be in the client's allow-list — the last of which
# only an operator can change. Optional: enables the idempotency replay case.
#
# That case issues a REAL invoice at the provider if the credential is a live one. Use a
# provider sandbox account, and read docs/live-testing.md §3 before setting this.
INVOICE_SERVICE_PROVIDER_CONFIG_ID=

# ─── payment-service ────────────────────────────────────────────────────────────────────
# Note the variable name: URL, not BASE_URL. The service's own docs spell it this way.
PAYMENT_SERVICE_URL=http://localhost:3002

# The merchant tier. Mint it with the credential's mode set to **sandbox** — that is what makes
# every payment under this key a sandbox payment. A production-mode key here moves real money.
PAYMENT_SERVICE_KEY=pmk_REPLACE_ME

# ─── Suite behaviour ────────────────────────────────────────────────────────────────────
# Off by default, and worth leaving off until every target above is a scratch database you are
# willing to leave rows in. Turning it on enables the create, publish and refresh cases.
LIVE_ALLOW_WRITES=false

# Turns "this service is not configured" from a skip into a failure. Leave `false` locally so
# you can run one service at a time; the release workflow sets it to `true`, deliberately —
# without it an unconfigured run skips every case and reports the same green as a full pass.
LIVE_REQUIRE_CONFIGURED=false

# ─── npm, for the release only ──────────────────────────────────────────────────────────
# Not read by `pnpm test:live`. It belongs on the `release` GitHub environment, and is listed
# here so one file describes everything a release needs.
#
# Create it at https://www.npmjs.com/settings/lazslov/tokens as an **Automation** token —
# a Publish token prompts for 2FA, which a workflow cannot answer. Grant it write access to
# the packages it publishes and nothing else.
NPM_TOKEN=npm_REPLACE_ME

# ─── Getting these into GitHub ──────────────────────────────────────────────────────────
# The release workflow is triggered by a pushed `v*` tag and reads these from the `release`
# environment — deliberately not from repository secrets, so a required reviewer can sit in
# front of them. Create the environment once:
#
#   gh api -X PUT repos/lazslov/lamido-api-sdk/environments/release
#
# Then push the values. `scripts/push-release-secrets.sh` reads this file's filled-in twin and
# sets each one without printing it:
#
#   ./scripts/push-release-secrets.sh
#
# Verify with `gh secret list --env release`, which shows names and never values.
