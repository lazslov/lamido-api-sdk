{
  "name": "@lazslov/content",
  "version": "2.0.1",
  "description": "Consumer SDK for content-service: pages, sections, collections, datasets and assets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazslov/lamido-api-sdk.git",
    "directory": "packages/content"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fields": {
      "import": {
        "types": "./dist/fields/index.d.ts",
        "default": "./dist/fields/index.js"
      },
      "require": {
        "types": "./dist/fields/index.d.cts",
        "default": "./dist/fields/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/next/index.d.cts",
        "default": "./dist/next/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "fields": [
        "./dist/fields/index.d.ts"
      ],
      "next": [
        "./dist/next/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check:package": "publint && attw --pack ."
  },
  "dependencies": {
    "@lazslov/api-core": "workspace:^"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
