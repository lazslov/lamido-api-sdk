{
  "name": "@lazslov/api-core",
  "version": "2.0.2",
  "description": "Shared transport, errors and signature verification for the @lazslov/* service SDKs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazslov/lamido-api-sdk.git",
    "directory": "packages/api-core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check:package": "publint && attw --pack ."
  },
  "dependencies": {}
}
